# Copie para .env e preencha. Nunca versione o .env.
APP_ENV=production
DOMAIN=api.sualoja.com.br
PUBLIC_BASE_URL=https://api.sualoja.com.br
SECRET_KEY=gere-com-openssl-rand-hex-32
POSTGRES_PASSWORD=troque-esta-senha

# WhatsApp Cloud API (Meta for Developers > seu app > WhatsApp)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=um-texto-qualquer-para-validar-o-webhook

# IA
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
OPENAI_API_KEY=

# Shopify
SHOPIFY_STORE_DOMAIN=sualoja.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Google Sheets (conta de serviço com acesso de editor à planilha)
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/google-service-account.json
GOOGLE_SHEETS_ID=

# Regras de negócio
PRIVACY_POLICY_URL=https://sualoja.com.br/privacidade
REMINDER_AFTER_MINUTES=10
MATCH_CONFIDENCE_THRESHOLD=0.75
