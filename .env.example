# Copie para .env e preencha. Nunca versione o .env.
APP_ENV=production
DOMAIN=api.sualoja.com.br
PUBLIC_BASE_URL=https://api.sualoja.com.br
SECRET_KEY=gere-com-openssl-rand-hex-32
POSTGRES_PASSWORD=troque-esta-senha

# WhatsApp Cloud API (Meta for Developers > seu app > WhatsApp)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=um-texto-qualquer-para-validar-o-webhook

# IA aberta, rodando no próprio servidor (sem chaves de API)
LLM_MODEL_TEXTO=qwen2.5:7b
LLM_MODEL_VISAO=qwen2.5vl:7b
LLM_TIMEOUT_SEGUNDOS=600
# Whisper local: tiny, base, small ou medium (maior = mais preciso e mais lento)
WHISPER_MODEL=small

# Loja (aparece nas mensagens de fechamento do pedido)
LOJA_NOME=Loja Elétrica
LOJA_ENDERECO=Av. Brasil, 500 - Centro
PIX_CHAVE=
PIX_TITULAR=

# Regras de negócio
PRIVACY_POLICY_URL=https://sualoja.com.br/privacidade
REMINDER_AFTER_MINUTES=10
MATCH_CONFIDENCE_THRESHOLD=0.75
