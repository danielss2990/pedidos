{$DOMAIN} {
	encode gzip

	@backend path /api/* /webhooks/* /health
	handle @backend {
		reverse_proxy api:8000
	}

	# Painel (SPA): rotas desconhecidas caem no index.html.
	handle {
		root * /srv/painel
		try_files {path} /index.html
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
